public class Penjualan {
    public static void main(String[] args) {
        int[] penjualan = {25, 30, 18, 40, 35, 45, 50};
        int total = 0;
        int max = penjualan[0];
        int min = penjualan[0];
        int jumlah = 0;
        for (int i = 0; i < penjualan.length; i++) {
            total += penjualan[i];
            if (penjualan[i] > max) {
                max = penjualan[i];
            }
            if (penjualan[i] < min) {
                min = penjualan[i];
            }
            if (penjualan[i] >= 30) {
                jumlah++;
            }
        }
        System.out.println("total penjualan:" + total);
        System.out.println("rata-rata:" + (total / 7.0));
        System.out.println("penjualan tertinggi:" + max);
        System.out.println("penjualan terendah:" + min);
        System.out.println("jumlah hari minimal 30:" + jumlah);
    }
}
