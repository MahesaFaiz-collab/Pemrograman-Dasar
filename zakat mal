import java.util.Scanner;
public class ZakatMal {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("total harta:");
        double harta = input.nextDouble();
        System.out.print("nilai nisab:");
        double nisab = input.nextDouble();
        if (harta >= nisab) {
            System.out.println("zakat:Rp" + (harta * 0.025));
        } else {
            System.out.println("belum mencapai nisab.");
        }
    }
}
