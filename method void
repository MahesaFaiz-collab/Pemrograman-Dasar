public class ContohMethod {
    // Method menampilkan judul
    static void tampilkanJudul() {
        System.out.println("=========================");
        System.out.println("   APLIKASI NILAI SISWA  ");
        System.out.println("=========================");
    }
    // Method menyapa pengguna
    static void sapaPengguna(String nama) {
        System.out.println("Halo, " + nama + "!");
    }
    public static void main(String[] args) {
        tampilkanJudul();
        sapaPengguna("Mahesa");
    }
}
