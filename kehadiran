public class Kehadiran {
    public static void main(String[] args) {
        int[] hadir = {14, 13, 16, 12, 15, 10, 16, 14};
        for (int i = 0; i < hadir.length; i++) {
            double persen = hadir[i] / 16.0 * 100;
            System.out.println("mahasiswa ke-" + (i + 1));
            System.out.println("kehadiran:" + persen + "%");
            if (persen >= 75) {
                System.out.println("memenuhi");
            } else {
                System.out.println("tidak Memenuhi");
            }
            System.out.println();
        }
    }
}
