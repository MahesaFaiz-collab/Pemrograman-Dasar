public class Kehadiran {
    public static void main(String[] args) {
        int[] hadir = {14, 13, 16, 12, 15, 10, 16, 14};
        int totalPertemuan = 16;
        System.out.println("=== HASIL KEHADIRAN ===");
        for (int i = 0; i < hadir.length; i++) {
            double persentase = (double) hadir[i] / totalPertemuan * 100;
            System.out.println("Mahasiswa ke-" + (i + 1));
            System.out.println("Persentase: " + persentase + "%");
            if (persentase >= 75) {
                System.out.println("Keterangan: Memenuhi");
            } else {
                System.out.println("Keterangan: Tidak Memenuhi");
            }
            System.out.println();
        }
    }
}
