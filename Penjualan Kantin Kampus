public class Penjualan {
    public static void main(String[] args) {
        int[] penjualan = {25, 30, 18, 40, 35, 45, 50};
        int total = 0;
        int max = penjualan[0];
        int min = penjualan[0];
        int jumlahHari = 0;
        // Menghitung total, tertinggi, terendah, dan jumlah hari
        for (int i = 0; i < penjualan.length; i++) {
            total += penjualan[i];
            if (penjualan[i] > max) {
                max = penjualan[i];
            }
            if (penjualan[i] < min) {
                min = penjualan[i];
            }
            if (penjualan[i] >= 30) {
                jumlahHari++;
            }
        }
        double rataRata = (double) total / penjualan.length;
        // Menampilkan hasil
        System.out.println("=== HASIL PENJUALAN ===");
        System.out.println("Total penjualan = " + total);
        System.out.println("Rata-rata = " + rataRata);
        System.out.println("Penjualan tertinggi = " + max);
        System.out.println("Penjualan terendah = " + min);
        System.out.println("Jumlah hari penjualan minimal 30 = " + jumlahHari);
    }
}
